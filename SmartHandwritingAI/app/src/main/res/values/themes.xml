<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.SmartHandwritingAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_card</item>
        <item name="android:windowBackground">@color/surface_bg</item>
        <item name="android:statusBarColor">@color/surface_bg</item>
        <item name="android:navigationBarColor">@color/nav_background</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- Material3 shape overrides -->
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.App.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.App.LargeComponent</item>

        <!-- Bottom Navigation styling -->
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
    </style>

    <style name="Theme.SmartHandwritingAI" parent="Base.Theme.SmartHandwritingAI" />

    <!-- Shape appearances -->
    <style name="ShapeAppearance.App.MediumComponent" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.App.LargeComponent" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <!-- Bottom Navigation -->
    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/nav_background</item>
        <item name="itemIconTint">@color/nav_inactive</item>
        <item name="itemTextColor">@color/nav_inactive</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.ActiveIndicator</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="elevation">0dp</item>
        <item name="itemRippleColor">@color/nav_indicator</item>
    </style>

    <style name="Widget.App.BottomNav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
    </style>

    <!-- Custom Theme for UCrop to style toolbar and prevent notch overlap -->
    <style name="Theme.AppUCrop" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
        
        <!-- Make toolbar taller so buttons are shifted down -->
        <item name="actionBarSize">72dp</item>
        <item name="android:actionBarSize">72dp</item>

        <!-- Custom close (X) button style -->
        <item name="toolbarNavigationButtonStyle">@style/Widget.App.UCrop.NavigationButton</item>
        
        <!-- Custom done (V) button style -->
        <item name="actionButtonStyle">@style/Widget.App.UCrop.ActionButton</item>
    </style>

    <style name="Widget.App.UCrop.NavigationButton" parent="Widget.AppCompat.Toolbar.Button.Navigation">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>

    <style name="Widget.App.UCrop.ActionButton" parent="Widget.AppCompat.ActionButton">
        <item name="android:minWidth">64dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>
</resources>