<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="32dp">

        <!-- Logo / Icon -->
        <com.airbnb.lottie.LottieAnimationView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="8dp"
            app:lottie_rawRes="@raw/ai_splash"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartHandwritingAI"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/tv_login_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="28dp"
            android:text="@string/login_subtitle"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Username Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="@string/login_hint_username"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="#10FFFFFF"
            app:boxStrokeColor="@color/primary"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:hintTextColor="@color/primary"
            android:textColorHint="#64748B"
            app:startIconDrawable="@drawable/ic_user"
            app:startIconTint="#94A3B8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:contentDescription="@string/login_hint_username" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Password Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="@string/login_hint_password"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="#10FFFFFF"
            app:boxStrokeColor="@color/primary"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:hintTextColor="@color/primary"
            android:textColorHint="#64748B"
            app:endIconMode="password_toggle"
            app:endIconTint="#94A3B8"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#94A3B8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:contentDescription="@string/login_hint_password" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Confirm Password (only visible in register mode) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:hint="@string/login_hint_confirm_password"
            android:visibility="gone"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="#10FFFFFF"
            app:boxStrokeColor="@color/primary"
            app:boxCornerRadiusTopStart="14dp"
            app:boxCornerRadiusTopEnd="14dp"
            app:boxCornerRadiusBottomStart="14dp"
            app:boxCornerRadiusBottomEnd="14dp"
            app:hintTextColor="@color/primary"
            android:textColorHint="#64748B"
            app:endIconMode="password_toggle"
            app:endIconTint="#94A3B8"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#94A3B8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:contentDescription="@string/login_hint_confirm_password" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Forgot Password -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_forgot_password"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginBottom="12dp"
            android:text="@string/login_btn_forgot_password"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Error Text -->
        <TextView
            android:id="@+id/tv_auth_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:text=""
            android:textColor="#EF4444"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Primary Action Button (Login / Register) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_login"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="16dp"
            android:text="@string/login_btn_login"
            android:textSize="15sp"
            android:textStyle="bold"
            android:contentDescription="@string/login_btn_login"
            app:backgroundTint="@color/primary"
            android:textColor="#FFFFFF"
            app:cornerRadius="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <!-- Toggle: Switch between Login / Register -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_toggle_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_toggle_hint"
                android:textColor="#94A3B8"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_toggle_mode"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_btn_toggle_register"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </LinearLayout>

        <!-- Skip -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_skip_login"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_btn_skip"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:contentDescription="@string/login_btn_skip" />

        <!-- Loading indicator -->
        <ProgressBar
            android:id="@+id/progress_auth"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
