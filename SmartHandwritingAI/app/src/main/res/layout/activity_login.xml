<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <!-- Logo / Icon -->
    <com.airbnb.lottie.LottieAnimationView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="8dp"
        app:lottie_rawRes="@raw/ai_splash"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SmartHandwritingAI"
        android:textColor="@color/white"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="40dp"
        android:text="Đăng nhập để đồng bộ lịch sử của bạn"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:gravity="center" />

    <!-- Email Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Email"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/accent"
        app:hintTextColor="@color/text_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="@color/white"
            android:contentDescription="Nhập địa chỉ email" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Password Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:hint="Mật khẩu"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        app:boxStrokeColor="@color/accent"
        app:hintTextColor="@color/text_secondary"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@color/white"
            android:contentDescription="Nhập mật khẩu" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Forgot Password -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_forgot_password"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="16dp"
        android:text="Quên mật khẩu?"
        android:textColor="@color/accent"
        android:textSize="13sp" />

    <!-- Error Text -->
    <TextView
        android:id="@+id/tv_auth_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:text=""
        android:textColor="@color/error"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Login Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_login"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="Đăng Nhập"
        android:textSize="16sp"
        android:textStyle="bold"
        android:contentDescription="Đăng nhập vào tài khoản"
        app:backgroundTint="@color/accent"
        app:cornerRadius="16dp" />

    <!-- Register Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_register"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:text="Tạo Tài Khoản Mới"
        android:textColor="@color/white"
        android:contentDescription="Tạo tài khoản mới"
        app:cornerRadius="16dp"
        app:strokeColor="@color/accent" />

    <!-- Skip -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_skip_login"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bỏ qua, dùng offline"
        android:textColor="@color/text_hint"
        android:textSize="13sp"
        android:contentDescription="Bỏ qua đăng nhập và dùng offline" />

    <!-- Loading indicator -->
    <ProgressBar
        android:id="@+id/progress_auth"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>
